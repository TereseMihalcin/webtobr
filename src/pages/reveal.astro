<style>
	.container {
		background: white;
	}
	.image img {
		max-width: 130px;
	}
	.boxes {
		/* ideally make this box same height as image */
		position: relative;
		top: -126px;
		z-index: 1;
		height: 126px;
		width: 155px;
		margin:auto;
		display: flex;
		flex-wrap: wrap;
	}
	.box {
      background-color: rgb(19, 19, 19);
	  opacity: 100%;
	  width: 10%;
	  height: 10%;
	}
	.btn {
		width: fit-content;
	}
</style>

<script type="text/javascript">

var startButton = document.getElementById('startButton');
var answer1 = document.getElementById('answer1');
var answer2 = document.getElementById('answer2');
var answer3 = document.getElementById('answer3');
var answer4 = document.getElementById('answer4');
var answer5 = document.getElementById('answer5');
// arr of boxes and ids
var boxes = document.querySelectorAll('.box');
var boxids = [];
for (var i = 0; i < boxes.length; i++) {
	boxids[i] = boxes[i].id;
}

// Start
startButton.addEventListener('click', function() {

	// get start time
	startTime = new Date().getTime();

	// shuffle boxes and set opacity to 0 one by one
	var shuffled = [];
	shuffled = shuffle(boxids);

	for (var i = 0; i < shuffled.length; i++) {
		var box = document.getElementById(shuffled[i]);
		console.log(box);
		setTimeout(function(box) {
			box.style.opacity = 0;
		}, i * 1000, box);
	}

	// activate answer buttons
	answer1.addEventListener('click', function() {
		checkAnswer('Voltorb');
	});
	answer2.addEventListener('click', function() {
		checkAnswer('Goomba');
	});
	answer3.addEventListener('click', function() {
		checkAnswer('Waddle Dee');
	});
	answer4.addEventListener('click', function() {
		checkAnswer('Donkey Kong');
	});
	answer5.addEventListener('click', function() {
		checkAnswer('Link');
	});

	
});

// Shuffle boxes
// Source - https://stackoverflow.com/a/18806417
// Posted by Ben Jackson, modified by community. See post 'Timeline' for change history
// Retrieved 2026-10-02, License - CC BY-SA 3.0
function shuffle(array) {
    var i = array.length,
        j = 0,
        temp;

    while (i--) {

        j = Math.floor(Math.random() * (i+1));

        // swap randomly chosen element with current element
        temp = array[i];
        array[i] = array[j];
        array[j] = temp;

    }
    return array;
}

// Check answer
function checkAnswer(answer) {
	if (answer === 'Waddle Dee') {
		// display time taken to answer
		var endTime = new Date().getTime();
		var millis = endTime - startTime;
		var seconds = ((millis % 60000) / 1000);
		alert('Correct! :: Time taken: ' + seconds + ' seconds');

		// set opacity to 0
		boxes.forEach(function(box) {
			box.style.opacity = 0;
		});
	} else {
		alert('Incorrect!');
	}
}

</script>